#!/usr/bin/env bash
# Tracked in the repo (unlike .git/hooks/), so it survives a fresh clone.
# Activate once per clone:   git config core.hooksPath .githooks
#
# Runs `frontend/run check`, the same gate CI runs. The coverage ratchet may
# tighten frontend/.quality_baseline.json; if it does, the new baseline is
# added to this commit so the gain is locked in.
#
# Path-gated: a commit touching only docs/ or the README skips the gate.
# N64MINI_SKIP_GATE=1 forces a skip; use it for a WIP commit and say so in the message.
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"
# Git runs hooks with GIT_DIR/GIT_INDEX_FILE set (in a submodule, to its .git/modules/ path). The
# gate's own git calls, and the tests' throwaway repos, would inherit them and use the wrong repo.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX GIT_OBJECT_DIRECTORY

GATE_PATHS='^(frontend/|themes/|\.githooks/|\.github/|\.agents/|\.secrets\.baseline|\.gitignore)'
STAGED="$(git diff --cached --name-only)"

if [ "${N64MINI_SKIP_GATE:-0}" = "1" ]; then
    echo "pre-commit: gate SKIPPED by N64MINI_SKIP_GATE=1 -- say why in the message."
    exit 0
fi
if ! printf '%s\n' "$STAGED" | grep -qE "$GATE_PATHS"; then
    echo "pre-commit: gate not run (docs-only commit)."
    exit 0
fi

frontend/run check
git add frontend/.quality_baseline.json
